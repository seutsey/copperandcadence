<!DOCTYPE html>
<html lang="en">
<head>
  <title>DJ Copper and Cadence – DJ and Karaoke Services</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Pacifico&family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "application" %>
</head>
<body>
  <header><nav>
    <%= link_to "DJ Copper and Cadence", root_path, class: "brand" %>
    <div>
      <%= link_to "Home", root_path, class: ("on" if current_page?(root_path)) %>
      <%= link_to "Schedule", schedule_path, class: ("on" if current_page?(schedule_path)) %>
      <%= link_to "Contact", contact_path, class: ("on" if current_page?(contact_path)) %>
    </div>
  </nav></header>
  <main>
    <% if notice %><p class="flash"><%= notice %></p><% end %>
    <%= yield %>
  </main>
  <footer>© <%= Date.current.year %> DJ Copper and Cadence · DJ and Karaoke Services ·
    <%= link_to "Admin", admin_root_path %></footer>
</body>
</html>
